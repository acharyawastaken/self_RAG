# Copy to `.env` and adjust. Every key is optional; values shown are the
# defaults in backend/app/config.py. Env var names are case-insensitive.

# --- Storage ---
# DATA_DIR=data/runtime

# --- Models ---
OLLAMA_HOST=http://localhost:11434
LLM_MODEL=llama3:latest
LLM_TIMEOUT_S=90.0
LLM_TEMPERATURE=0.1
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_QUERY_PREFIX="Represent this sentence for searching relevant passages: "

# --- Chunking ---
CHUNK_SIZE_TOKENS=300
CHUNK_OVERLAP_TOKENS=45

# --- Retrieval ---
TOP_K=3
LESSON_TOP_K=2
MIN_LESSON_SIMILARITY=0.60
WEAK_EVIDENCE_SIMILARITY=0.40

# --- Upload limits ---
MAX_UPLOAD_MB=25

# --- Prompts ---
ANSWER_PROMPT_VERSION=answer_v1
CRITIC_PROMPT_VERSION=critic_v1
JUDGE_PROMPT_VERSION=judge_v1

# --- Obsidian Knowledge Graph ---
OBSIDIAN_ENABLED=true
GRAPHIFY_ENABLED=true
CONCEPT_MATCH_THRESHOLD=85

# --- CORS (JSON list) ---
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
